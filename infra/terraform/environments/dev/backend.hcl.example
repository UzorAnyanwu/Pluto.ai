# Copy to backend.hcl (gitignored — bucket names are account-specific) and run:
#   terraform init -backend-config=backend.hcl
bucket         = "pluto-ai-terraform-state-dev"
key            = "dev/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "pluto-ai-terraform-locks-dev"
encrypt        = true
